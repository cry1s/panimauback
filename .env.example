# .env.example
# Copy this file to .env and fill real values.

# Bot token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram group ID where the bot watches messages
GROUP_ID=-1234567890

# Target channel username or ID
CHANNEL_ID=@your_channel

# Comma-separated Telegram user IDs allowed to run admin commands
ADMIN_IDS=123456789,987654321

# Optional: delay before publishing media, in seconds
DOWNLOAD_DELAY_SECONDS=5

# Optional: persistent deployment flags and feedback storage
BOT_STATE_DIR=data

# Optional: enables the secret pantry drip-feed when set (VK API service token)
VK_SERVICE_TOKEN=

# Optional: pantry source community domain
VK_SOURCE_DOMAIN=panim4u

# Optional: pantry drip-feed tuning
ARCHIVE_TRIGGER_POSTS=3
ARCHIVE_MIN_DELAY_SECONDS=3600
ARCHIVE_MAX_DELAY_SECONDS=86400
